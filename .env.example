# --- Google Sheets -------------------------------------------------------
# Base64-encoded Google Service Account JSON (see README for how to generate).
GCP_SERVICE_ACCOUNT_KEY=
# The ID string from the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# --- DeepSeek ------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional: override the default model ("deepseek-chat"). e.g. deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-chat

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Primary chat/channel that always receives the daily post, in addition to every
# chat ID saved in data/subscribers.json (added automatically on /start).
TELEGRAM_CHAT_ID=

# --- Optional ------------------------------------------------------------
# LOG_LEVEL=INFO
