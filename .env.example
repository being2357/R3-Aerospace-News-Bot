# --- Google Sheets -------------------------------------------------------
# Base64-encoded Google Service Account JSON (see README for how to generate).
GCP_SERVICE_ACCOUNT_KEY=
# The ID string from the sheet's URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=

# --- DeepSeek ------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional: override the default model ("deepseek-chat"). e.g. deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-chat

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Primary chat/channel that always receives the daily post. Used as the fallback
# recipient when the subscriber CSV below is empty or fails to load.
TELEGRAM_CHAT_ID=

# --- Subscribers (published Google Sheet CSV) ----------------------------
# Public "publish to web" CSV URL of a Google Sheet whose first row has a
# `chat_id` column. The daily digest is sent to every chat ID listed here.
# Example: https://docs.google.com/spreadsheets/d/<ID>/gviz/tq?tqx=out:csv
GOOGLE_SHEET_CSV_URL=

# --- Optional ------------------------------------------------------------
# LOG_LEVEL=INFO
